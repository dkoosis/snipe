# pack --depth sym (def+refs+callers+callees, no package context).
# Proves: `pack --depth sym Greet` renders the definition in concise and json,
# --refs-limit narrows it, and a bare symbol routes to the same output.
cd $FIXTURE
exec snipe pack --depth sym Greet
stdout '# Greet'
stdout 'func Greet\(\) string'
! stderr .
cp stdout $WORK/sym.txt

exec snipe pack --depth sym Greet --format json
stdout '"results"'

exec snipe pack --depth sym Greet --refs-limit 1
stdout '# Greet'

# A bare symbol routes to pack --depth sym with no nudge.
exec snipe Greet
cmp stdout $WORK/sym.txt
! stderr .
