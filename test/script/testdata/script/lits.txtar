# search --lits (locations of a string literal or env var).
# Proves: `search --lits banner-token-literal` resolves the named const Banner,
# and an env var name resolves to its reader, in concise and json.
cd $FIXTURE
exec snipe search --lits banner-token-literal
stdout '# Banner'
stdout 'const'
! stderr .

exec snipe search --lits banner-token-literal --format json
stdout '"results"'

# An env var name (read by beta.Reply).
exec snipe search --lits FIXTURE_ENV_TOKEN
stdout 'beta'
exec snipe search --lits FIXTURE_ENV_TOKEN --format json
stdout '"results"'

# The modes are exclusive, and --file filters text search only.
! exec snipe search --lits --trace banner-token-literal
stderr 'can''t be used together'
! exec snipe search --lits --file '*.go' banner-token-literal
stdout '--file filters text search only'
