# pack — deep dive on one symbol (def+refs+callers+callees+role+purpose).
# Proves: `pack Greet` renders the role classification and the definition block,
# and --depth pack (the default) prints the same thing.
cd $FIXTURE
exec snipe pack Greet
stdout '# Greet'
stdout 'role: api_boundary'
! stderr .
cp stdout $WORK/pack.txt
exec snipe pack --depth pack Greet
cmp stdout $WORK/pack.txt

exec snipe pack Greet --format json
cp stdout $WORK/pack.json
exec snipe pack --depth pack Greet --format json
cmpjson stdout $WORK/pack.json

# --depth sym and --depth explain take one symbol.
! exec snipe pack --depth sym Greet Reply
stderr 'takes one symbol'
