# pack — deep dive on one symbol (def+refs+callers+callees+role+purpose).
# Proves: `pack Greet` renders the role classification and the definition block,
# and --depth pack (the default) prints the same thing.
cd $FIXTURE
exec snipe pack Greet
stdout '# Greet'
stdout 'role: api_boundary'
! stderr .
cp stdout $WORK/pack.txt
exec snipe pack --depth pack Greet
cmp stdout $WORK/pack.txt

exec snipe pack Greet --format json
cp stdout $WORK/pack.json
exec snipe pack --depth pack Greet --format json
cmpjson stdout $WORK/pack.json

# --depth sym and --depth explain take one symbol.
# The error is an INVALID_ARGS envelope on stdout (exit 2, pinned in
# TestExitCodeContract), so a --format json caller can parse it.
! exec snipe pack --depth sym Greet Reply
stdout 'takes one symbol'
! exec snipe pack --depth explain Greet Reply --format json
stdout '"code":"INVALID_ARGS"'
stdout 'takes one symbol'

# A flag the chosen depth ignores is a usage error, not a silent no-op:
# --mode/--warnings belong to explain, the limits to sym and pack.
! exec snipe pack Greet --mode deep
stdout 'pack --mode needs --depth explain'
! exec snipe pack --depth sym Greet --warnings full --format json
stdout '"code":"INVALID_ARGS"'
stdout 'pack --warnings needs --depth explain'
! exec snipe pack --depth explain Greet --refs-limit 3
stdout '--refs-limit'
