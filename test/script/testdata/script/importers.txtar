# deps --importers (files that import a package).
# Proves: `deps --importers <alpha>` finds both import sites (main.go and
# beta/beta.go), in concise and json.
cd $FIXTURE
exec snipe deps --importers example.com/fixture/alpha
stdout 'main\.go:4 \| import'
stdout 'beta/beta\.go:3 \| import'
! stderr .

exec snipe deps --importers example.com/fixture/alpha --format json
stdout '"results"'

# A flag and a positional package together is a usage error, not a silent pick.
# It comes back as an INVALID_ARGS envelope on stdout (exit 2, pinned in
# TestExitCodeContract), so a --format json caller can parse it.
! exec snipe deps --importers example.com/fixture/alpha example.com/fixture/beta
stdout 'extra argument'
! exec snipe deps --importers example.com/fixture/alpha example.com/fixture/beta --format json
stdout '"code":"INVALID_ARGS"'

# An empty package is a usage error, not the bare graph.
! exec snipe deps --importers ''
stdout 'deps --importers needs a package'
! stdout 'example.com/fixture'
