# search — text search via ripgrep (no index required).
# Proves: `search Greet` finds the symbol's source lines in the alpha package,
# and still works with no index; the folded modes (--lits, --trace, --semantic)
# are flags of the same verb.
cd $FIXTURE
exec snipe search Greet
stdout '# Greet'
stdout 'alpha/alpha\.go'
! stderr .

# No index: plain search still runs; a folded mode that needs one says so.
rm .snipe
exec snipe search Greet
stdout 'alpha/alpha\.go'
! exec snipe search --lits banner-token-literal
stdout 'index'

# search --help names the three modes.
exec snipe search --help
stdout '--lits'
stdout '--trace'
stdout '--semantic'

# --threshold belongs to --semantic; an empty semantic query is a usage error.
! exec snipe search Greet --threshold 0.9
stdout '--threshold applies to --semantic only'
! exec snipe search --semantic ''
stdout 'search --semantic needs a query'
