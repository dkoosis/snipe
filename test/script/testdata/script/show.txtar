# show — hidden alias of def <id>; prints one stderr nudge, then runs def.
# Proves: the nudge appears once on stderr, stdout is def's, and def's id path
# answers (a bogus 16-char hex id reaches the id lookup, not the name lookup).
cd $FIXTURE
! exec snipe show deadbeefdeadbeef
stdout 'symbol deadbeefdeadbeef not found'
stderr -count=1 'snipe: ''show'' is now ''def'''
! exec snipe def deadbeefdeadbeef
stdout 'symbol deadbeefdeadbeef not found'
! stderr 'is now'
