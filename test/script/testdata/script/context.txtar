# context — Claude-optimized project orientation (entry points, build, packages).
# Proves: a bare run over the indexed fixture renders the structural orientation
# sections Claude reads first.
cd $FIXTURE
exec snipe context
stdout '## build'
stdout '## key symbols'

# context --out writes the orient bundle with no nudge.
exec snipe context --out $WORK/cbundle
stdout 'orient bundle · \d+ files'
! stderr 'is now'
exists $WORK/cbundle/manifest.json
